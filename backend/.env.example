# Leave unset locally to use a SQLite file (local.db).
# On Vercel, installing Neon from the Marketplace sets this for you;
# `vercel env pull .env.local` copies it down if you want to use Neon locally.
# Use the POOLED connection string.
DATABASE_URL=

# AI dispatcher (optional). Without these the app writes its own briefing and
# uses the browser's voice. Keep real keys in backend/.env.local, never commit them.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
