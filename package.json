{
  "name": "hackathon-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "cd backend && python -m uvicorn api.index:app --reload --port 8000",
    "build": "npm run build -w frontend",
    "typecheck": "npm run typecheck -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
